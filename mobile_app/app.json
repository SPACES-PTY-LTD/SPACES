{
  "expo": {
    "name": "Spaces Digital",
    "slug": "spaces-digital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "expodriverapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spaces.logistics"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/branding/android-foreground.png",
        "monochromeImage": "./assets/branding/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spaces.logistics"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Spaces Digital to use the camera to scan parcel QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "497d04a7-b1e5-48b9-a4fa-84c67c26f325"
      }
    },
    "owner": "leroyg"
  }
}
